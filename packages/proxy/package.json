{
  "name": "@bouncer/mcp-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "bouncer-mcp-proxy": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "demo": "tsx ../../demo/run-counterfactual.ts",
    "demo:offline": "tsx ../../demo/run-counterfactual.ts --offline"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
